  "components": {
    "schemas": {
      "AnalysisInput": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Snapshot Id"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "default": "Wallet activity review"
          },
          "enable_ml": {
            "type": "boolean",
            "title": "Enable Ml",
            "default": true
          },
          "large_transfer_thresholds": {
            "items": {
              "$ref": "#/components/schemas/AssetThreshold"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Large Transfer Thresholds"
          },
          "high_fee_wei": {
            "type": "string",
            "title": "High Fee Wei",
            "default": "10000000000000000"
          },
          "burst_count": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 2.0,
            "title": "Burst Count",
            "default": 10
          },
          "burst_window_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Burst Window Seconds",
            "default": 60
          },
          "concentration_limit": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Concentration Limit",
            "default": 0.7
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot_id"
        ],
        "title": "AnalysisInput"
      },
      "AssetThreshold": {
        "properties": {
          "asset_id": {
            "type": "string",
            "title": "Asset Id"
          },
          "amount_base_units": {
            "type": "string",
            "title": "Amount Base Units"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asset_id",
          "amount_base_units"
        ],
        "title": "AssetThreshold"
      },
      "BlockInput": {
        "properties": {
          "number": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Number"
          },
          "hash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$",
            "title": "Hash"
          },
          "parent_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$",
            "title": "Parent Hash"
          },
          "timestamp": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Timestamp"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "number",
          "hash",
          "parent_hash",
          "timestamp"
        ],
        "title": "BlockInput"
      },
      "ContractInput": {
        "properties": {
          "address": {
            "type": "string",
            "title": "Address"
          },
          "label": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Label"
          },
          "token_decimals": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 36.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Token Decimals"
          },
          "opening_balance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opening Balance"
          },
          "closing_balance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closing Balance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "address",
          "label"
        ],
        "title": "ContractInput"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JsonPreviewInput": {
        "properties": {
          "snapshot_json": {
            "type": "string",
            "maxLength": 6000000,
            "minLength": 1,
            "title": "Snapshot Json"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot_json"
        ],
        "title": "JsonPreviewInput"
      },
      "LogInput": {
        "properties": {
          "transaction_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$",
            "title": "Transaction Hash"
          },
          "block_number": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Block Number"
          },
          "block_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$",
            "title": "Block Hash"
          },
          "transaction_index": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Transaction Index"
          },
          "log_index": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Log Index"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "topics": {
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Topics"
          },
          "data": {
            "type": "string",
            "maxLength": 8194,
